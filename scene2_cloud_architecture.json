{
  "schemaVersion": "1.0",
  "id": "cloud-architecture-flowchart",
  "title": "Global Zero-Trust Edge Mesh & Replication",
  "description": "2.5D extruded infrastructure nodes, reusable server symbols, animated orthogonal & curved connectors, and radial SLA gauges.",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "duration": 5.5,
  "fonts": [
    {
      "family": "Inter",
      "weights": [
        500,
        600,
        700,
        800
      ]
    }
  ],
  "background": {
    "gradient": {
      "type": "linear",
      "angle": 160,
      "stops": [
        {
          "offset": 0,
          "color": "#022c22"
        },
        {
          "offset": 0.5,
          "color": "#06191e"
        },
        {
          "offset": 1,
          "color": "#090d16"
        }
      ]
    },
    "grid": {
      "enabled": true,
      "spacing": 50,
      "color": "#10b981",
      "opacity": 0.14,
      "isometric": true
    },
    "vignette": {
      "intensity": 0.45
    }
  },
  "defs": {
    "serverNode": {
      "id": "serverNode",
      "name": "2.5D Extruded Edge Server Node",
      "type": "group",
      "children": [
        {
          "id": "nodeCard",
          "type": "rect",
          "width": 250,
          "height": 130,
          "cornerRadius": 18,
          "fill": "#0f172a",
          "stroke": "#10b981",
          "strokeWidth": 3,
          "depth25d": {
            "extrudeX": 12,
            "extrudeY": 14,
            "extrudeColor": "#064e3b",
            "elevation": 18
          }
        },
        {
          "id": "led1",
          "type": "circle",
          "x": -92,
          "y": -36,
          "radius": 6,
          "fill": "#34d399"
        },
        {
          "id": "led2",
          "type": "circle",
          "x": -72,
          "y": -36,
          "radius": 6,
          "fill": "#38bdf8"
        },
        {
          "id": "slotLine",
          "type": "line",
          "x1": -95,
          "y1": 28,
          "x2": 95,
          "y2": 28,
          "stroke": "#1e293b",
          "strokeWidth": 6
        }
      ]
    }
  },
  "layers": [
    {
      "id": "layer-arch-header",
      "name": "Architecture Title Header",
      "zIndex": 1,
      "elements": [
        {
          "id": "arch-tag",
          "type": "text",
          "x": 960,
          "y": 72,
          "text": "SYSTEMS ARCHITECTURE  \u2022  MULTI-REGION REPLICATION",
          "fontSize": 15,
          "fontWeight": 700,
          "fill": "#34d399",
          "backgroundBox": {
            "fill": "rgba(6, 78, 59, 0.55)",
            "stroke": "#10b981",
            "padding": [
              18,
              8
            ],
            "cornerRadius": 18
          },
          "entrance": {
            "type": "slideDown",
            "duration": 0.5
          }
        },
        {
          "id": "arch-title",
          "type": "text",
          "x": 960,
          "y": 138,
          "text": "Sub-15ms Global Edge Consensus Pipeline",
          "fontSize": 44,
          "fontWeight": 800,
          "fill": "#f8fafc",
          "entrance": {
            "type": "fade",
            "delay": 0.2,
            "duration": 0.6
          }
        }
      ]
    },
    {
      "id": "layer-mesh-links",
      "name": "Animated Network Connectors",
      "zIndex": 2,
      "elements": [
        {
          "id": "conn-ingress-gateway",
          "type": "connector",
          "from": [
            330,
            540
          ],
          "to": [
            760,
            540
          ],
          "routing": "straight",
          "stroke": "#38bdf8",
          "strokeWidth": 4,
          "endHead": "arrow",
          "label": "TLS 1.3 + QUIC",
          "flowParticles": {
            "count": 4,
            "speed": 0.85,
            "radius": 5,
            "color": "#38bdf8"
          },
          "keyframes": [
            {
              "time": 0.3,
              "trimEnd": 0
            },
            {
              "time": 1.2,
              "trimEnd": 1,
              "easing": "easeOutCubic"
            }
          ]
        },
        {
          "id": "conn-gateway-us",
          "type": "connector",
          "from": [
            910,
            480
          ],
          "to": [
            1390,
            310
          ],
          "routing": "orthogonal",
          "stroke": "#34d399",
          "strokeWidth": 3.5,
          "endHead": "arrow",
          "label": "Raft Primary (11ms)",
          "flowParticles": {
            "count": 4,
            "speed": 0.9,
            "radius": 5,
            "color": "#34d399"
          },
          "keyframes": [
            {
              "time": 1,
              "trimEnd": 0
            },
            {
              "time": 2,
              "trimEnd": 1,
              "easing": "easeOutCubic"
            }
          ]
        },
        {
          "id": "conn-gateway-eu",
          "type": "connector",
          "from": [
            910,
            540
          ],
          "to": [
            1390,
            540
          ],
          "routing": "straight",
          "stroke": "#10b981",
          "strokeWidth": 3.5,
          "endHead": "arrow",
          "label": "Sync Replica (14ms)",
          "flowParticles": {
            "count": 4,
            "speed": 0.8,
            "radius": 5,
            "color": "#10b981"
          },
          "keyframes": [
            {
              "time": 1.15,
              "trimEnd": 0
            },
            {
              "time": 2.15,
              "trimEnd": 1,
              "easing": "easeOutCubic"
            }
          ]
        },
        {
          "id": "conn-gateway-apac",
          "type": "connector",
          "from": [
            910,
            600
          ],
          "to": [
            1390,
            770
          ],
          "routing": "orthogonal",
          "stroke": "#818cf8",
          "strokeWidth": 3.5,
          "endHead": "arrow",
          "label": "Async Read Pool (19ms)",
          "flowParticles": {
            "count": 3,
            "speed": 0.7,
            "radius": 5,
            "color": "#818cf8"
          },
          "keyframes": [
            {
              "time": 1.3,
              "trimEnd": 0
            },
            {
              "time": 2.3,
              "trimEnd": 1,
              "easing": "easeOutCubic"
            }
          ]
        }
      ]
    },
    {
      "id": "layer-mesh-nodes",
      "name": "2.5D Infrastructure Nodes & Gauges",
      "zIndex": 3,
      "elements": [
        {
          "id": "ingress-hub",
          "type": "group",
          "x": 240,
          "y": 540,
          "entrance": {
            "type": "pop",
            "delay": 0.15,
            "duration": 0.55
          },
          "children": [
            {
              "id": "ingress-outer-arc",
              "type": "arc",
              "radius": 96,
              "innerRadius": 74,
              "startAngle": -90,
              "endAngle": 255,
              "fill": "#38bdf8",
              "keyframes": [
                {
                  "time": 0.2,
                  "trimEnd": 0
                },
                {
                  "time": 1.8,
                  "trimEnd": 1,
                  "easing": "easeOutQuart"
                }
              ]
            },
            {
              "id": "ingress-core",
              "type": "circle",
              "radius": 64,
              "fill": "#0f172a",
              "stroke": "#38bdf8",
              "strokeWidth": 2
            },
            {
              "id": "ingress-title",
              "type": "text",
              "y": -8,
              "text": "ANYCAST",
              "fontSize": 16,
              "fontWeight": 800,
              "fill": "#38bdf8"
            },
            {
              "id": "ingress-sub",
              "type": "text",
              "y": 16,
              "text": "310 PoPs",
              "fontSize": 14,
              "fontWeight": 600,
              "fill": "#e2e8f0"
            }
          ]
        },
        {
          "id": "edge-router-node",
          "type": "use",
          "ref": "serverNode",
          "x": 835,
          "y": 540,
          "entrance": {
            "type": "pop",
            "delay": 0.65,
            "duration": 0.5
          }
        },
        {
          "id": "edge-router-label",
          "type": "text",
          "x": 835,
          "y": 534,
          "text": "EDGE ROUTER MESH\nZero-Trust Policy Engine",
          "fontSize": 17,
          "fontWeight": 700,
          "fill": "#f8fafc",
          "entrance": {
            "type": "fade",
            "delay": 0.8,
            "duration": 0.4
          }
        },
        {
          "id": "region-us-node",
          "type": "use",
          "ref": "serverNode",
          "x": 1525,
          "y": 310,
          "entrance": {
            "type": "slideLeft",
            "delay": 1.4,
            "duration": 0.5
          }
        },
        {
          "id": "region-us-label",
          "type": "text",
          "x": 1525,
          "y": 304,
          "text": "US-EAST CLUSTER\nLeader Shard \u2022 NVMe",
          "fontSize": 17,
          "fontWeight": 700,
          "fill": "#f8fafc",
          "entrance": {
            "type": "fade",
            "delay": 1.55,
            "duration": 0.4
          }
        },
        {
          "id": "region-eu-node",
          "type": "use",
          "ref": "serverNode",
          "x": 1525,
          "y": 540,
          "entrance": {
            "type": "slideLeft",
            "delay": 1.6,
            "duration": 0.5
          }
        },
        {
          "id": "region-eu-label",
          "type": "text",
          "x": 1525,
          "y": 534,
          "text": "EU-CENTRAL CLUSTER\nQuorum Follower \u2022 GDPR",
          "fontSize": 17,
          "fontWeight": 700,
          "fill": "#f8fafc",
          "entrance": {
            "type": "fade",
            "delay": 1.75,
            "duration": 0.4
          }
        },
        {
          "id": "region-apac-node",
          "type": "use",
          "ref": "serverNode",
          "x": 1525,
          "y": 770,
          "overrides": {
            "nodeCard": {
              "stroke": "#818cf8"
            }
          },
          "entrance": {
            "type": "slideLeft",
            "delay": 1.8,
            "duration": 0.5
          }
        },
        {
          "id": "region-apac-label",
          "type": "text",
          "x": 1525,
          "y": 764,
          "text": "APAC-TOKYO CLUSTER\nRead Replica \u2022 Edge Cache",
          "fontSize": 17,
          "fontWeight": 700,
          "fill": "#f8fafc",
          "entrance": {
            "type": "fade",
            "delay": 1.95,
            "duration": 0.4
          }
        },
        {
          "id": "uptime-banner",
          "type": "text",
          "x": 835,
          "y": 925,
          "text": "CONSENSUS COMMITTED IN 12.4ms  \u2022  99.999% AVAILABILITY SLA",
          "fontSize": 18,
          "fontWeight": 700,
          "fill": "#ecfdf5",
          "backgroundBox": {
            "fill": "rgba(6, 78, 59, 0.82)",
            "stroke": "#34d399",
            "strokeWidth": 2,
            "padding": [
              28,
              14
            ],
            "cornerRadius": 14
          },
          "entrance": {
            "type": "slideUp",
            "delay": 2.3,
            "duration": 0.55
          }
        }
      ]
    }
  ]
}